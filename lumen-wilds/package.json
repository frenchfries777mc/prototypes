{
  "name": "lumen-wilds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev:server": "npm run dev -w @lw/server",
    "dev:client": "npm run dev -w @lw/client",
    "build": "npm run build -w @lw/client",
    "start": "npm run start -w @lw/server",
    "bots": "npm run bots -w @lw/server --",
    "test": "vitest run",
    "typecheck": "tsc -p packages/shared && tsc -p packages/server && tsc -p packages/client"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
