{
  "name": "althistory",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "fetch:data": "node scripts/fetch-data.mjs",
    "build:map": "node scripts/build-map.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "build:single": "node -e \"const f=require('fs');f.writeFileSync('standalone.html',f.readFileSync('index.html','utf8').replace('/src/main.ts','/src/standalone.ts'))\" && vite build --config vite.standalone.config.ts && node -e \"require('fs').copyFileSync('dist-single/standalone.html','althist.html')\"",
    "test:e2e": "node tests/e2e.cjs && node tests/e2e-armies.cjs && node tests/e2e-studio.cjs && node tests/e2e-history.cjs && node tests/e2e-paper.cjs && node tests/e2e-ai.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "maplibre-gl": "^6.19.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/topojson-client": "^3.1.5",
    "mapshaper": "^0.8.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
